# Growth OS · panel web (variables PÚBLICAS: terminan en el navegador)
# URL del proyecto Supabase donde están las tablas growth_* (hoy: staging)
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
# Clave pública del proyecto (anon o sb_publishable_...). Nunca la service role.
VITE_SUPABASE_ANON_KEY=
# Opcional: dominio propio para los links trackeados (si no, se usa la Edge Function growth-go)
VITE_GROWTH_LINK_BASE=
VITE_GROWTH_LANDING_BASE= # dominio donde publiques growth/landing/registro.html (ej. https://www.trattoapp.com.ar/registro)
