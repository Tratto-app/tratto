# Growth OS · secrets de las Edge Functions (NUNCA en el repo ni en el navegador)
# Se cargan con:  supabase secrets set --project-ref <ref> NOMBRE=valor
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los pone Supabase solo.

# IA (sin esta clave la IA responde por reglas: modo simulado)
OPENAI_API_KEY=
GROWTH_AI_MODEL=gpt-4o-mini

# Email (Brevo)
BREVO_API_KEY=
GROWTH_EMAIL_FROM=
GROWTH_EMAIL_FROM_NAME=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Instagram Messaging (solo responder a quien escribió primero)
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v21.0

# Generales
GROWTH_DAILY_SEND_LIMIT=200
# Orígenes permitidos para el panel (coma). Por defecto *.
GROWTH_ALLOWED_ORIGINS=
# Dominio propio para los links trackeados (opcional)
GROWTH_LINK_BASE=
