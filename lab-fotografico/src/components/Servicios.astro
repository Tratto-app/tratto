---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { servicios } from '../lib/contenido';

// Los dos primeros servicios van más grandes (destacados).
const DESTACADOS = 2;
const anchos = (max: number, lista: number[]) => {
  const w = lista.filter((x) => x <= max);
  return w.length ? w : [max];
};
---
<section id="servicios" class="bg-papel" aria-labelledby="titulo-servicios">
  <div class="contenedor py-16 lg:py-28">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end" data-revelar>
      <div class="lg:col-span-7">
        <p class="etiqueta">Servicios</p>
        <h2 id="titulo-servicios" class="titulo-seccion mt-3">{servicios.titulo}</h2>
      </div>
      {servicios.bajada && <p class="text-gris lg:col-span-5 lg:pb-2">{servicios.bajada}</p>}
    </div>

    <ul class="grilla mt-10 lg:mt-16" role="list">
      {servicios.lista.map((s, i) => {
        const destacado = i < DESTACADOS;
        return (
          <li class:list={['tarjeta group', destacado && 'destacada']} data-revelar style={`--demora:${(i % 3) * 60}ms`}>
            <div class="foto relative overflow-hidden bg-mesa">
              {s.imagen && (
                <Image
                  src={s.imagen}
                  alt={s.foto_descripcion}
                  widths={destacado ? anchos(s.imagen.width, [480, 720, 960, 1200]) : anchos(s.imagen.width, [240, 400, 600, 800])}
                  sizes={destacado
                    ? '(min-width: 1280px) 600px, (min-width: 640px) 46vw, 92vw'
                    : '(min-width: 1280px) 390px, (min-width: 768px) 31vw, (min-width: 640px) 45vw, 96px'}
                  format="webp"
                  quality={85}
                  class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-revelado)] group-hover:scale-[1.04]"
                />
              )}
            </div>
            <div class="texto flex min-w-0 flex-col">
              {s.detalle && <p class="font-mono text-[.7rem] uppercase tracking-[.08em] text-gris">{s.detalle}</p>}
              <h3 class="mt-1.5 text-[1.05rem] font-semibold leading-snug sm:text-[1.12rem]">{s.nombre}</h3>
              <p class="descripcion mt-1.5 text-[.93rem] leading-relaxed text-gris">{s.descripcion}</p>
              {s.opciones.length > 0 && (
                <ul class="opciones mt-3 grid gap-1.5 text-[.9rem] leading-snug text-grafito" role="list">
                  {s.opciones.map((o) => <li>{o}</li>)}
                </ul>
              )}
              {s.nota && <p class="mt-3 text-[.86rem] text-gris">{s.nota}</p>}
              {s.ancla && (
                <a href={`#${s.ancla}`} class="mas-info mt-3">{s.ancla_texto || 'Ver más'} <span aria-hidden="true">↓</span></a>
              )}
              <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-1 pt-3">
                {s.precio && <p class="font-display text-[1.35rem] leading-none tabular-nums">{s.precio}</p>}
                <a href={s.whatsapp} target="_blank" rel="noopener" class="consultar" aria-label={`Consultar por ${s.nombre} por WhatsApp`}>
                  Consultar
                  <Icono nombre="flecha" tamano={16} />
                </a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .grilla { display: grid; gap: 1.25rem; }
  .tarjeta { min-width: 0; position: relative; }

  /* Celular: lista compacta con foto chica a la izquierda (como un catálogo) */
  .tarjeta:not(.destacada) { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--color-linea); }
  .tarjeta:not(.destacada) .foto { aspect-ratio: 1; }
  .tarjeta.destacada { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 1.25rem; }
  .tarjeta.destacada .foto { aspect-ratio: 16 / 10; }

  .opciones li { position: relative; padding-left: 1rem; }
  .opciones li::before { content: ""; position: absolute; left: 0; top: .5em; width: .4rem; height: .4rem; border-radius: 999px; background: var(--color-magenta); }
  .opciones li:nth-child(3n+2)::before { background: var(--color-cian); }
  .opciones li:nth-child(3n+3)::before { background: var(--color-amarillo); }

  .consultar {
    display: inline-flex; align-items: center; gap: .4rem;
    font-weight: 600; font-size: .95rem; color: var(--color-magenta);
    padding-block: .35rem;
  }
  .consultar :global(svg) { transition: transform .3s var(--ease-revelado); }
  .consultar:hover :global(svg) { transform: translateX(4px); }
  /* Toda la tarjeta se puede tocar, pero el enlace real es "Consultar" */
  .consultar::after { content: ""; position: absolute; inset: 0; }
  .consultar:focus-visible { outline: none; }
  .mas-info { position: relative; z-index: 1; align-self: flex-start; font-size: .9rem; font-weight: 600; color: var(--color-tinta); text-decoration: underline; text-decoration-color: var(--color-cian); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .mas-info:hover { color: var(--color-magenta); }
  .tarjeta:has(.consultar:focus-visible) { outline: 2px solid var(--color-magenta); outline-offset: 6px; }

  @media (min-width: 640px) {
    .grilla { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.75rem 1.5rem; }
    .tarjeta:not(.destacada) { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 0; border-bottom: 0; }
    .tarjeta:not(.destacada) .foto { aspect-ratio: 4 / 3; }
    .tarjeta.destacada { grid-column: span 2; padding-bottom: 0; }
  }
  @media (min-width: 768px) {
    .grilla { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tarjeta:not(.destacada) { grid-column: span 2; }
    .tarjeta.destacada { grid-column: span 6; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1.75rem; align-items: start; }
    .tarjeta.destacada .foto { aspect-ratio: 4 / 3; }
    .tarjeta.destacada h3 { font-family: var(--font-display); font-weight: 400; font-size: 2.1rem; line-height: 1.02; letter-spacing: -.01em; margin-top: .6rem; }
    .tarjeta.destacada .descripcion { font-size: 1rem; margin-top: .75rem; }
  }
  @media (min-width: 1024px) {
    .grilla { gap: 3.5rem 1.75rem; }
    .tarjeta.destacada { grid-column: span 3; grid-template-columns: 1fr; gap: 1.1rem; }
    .tarjeta.destacada .foto { aspect-ratio: 16 / 10; }
  }
</style>
