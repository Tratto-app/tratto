---
import Icono from './Icono.astro';
import { comoEnviar as ce, negocio } from '../lib/contenido';
import { destacar } from '../lib/formato';
---
<section id="como-enviar" class="bg-mesa" aria-labelledby="titulo-enviar">
  <div class="contenedor py-16 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5" data-revelar>
        <p class="etiqueta">{ce.etiqueta}</p>
        <h2 id="titulo-enviar" class="titulo-seccion destacable mt-3" set:html={destacar(ce.titulo)} />
        {ce.bajada && <p class="mt-5 text-[1.04rem] leading-relaxed text-gris">{ce.bajada}</p>}
        <dl class="mt-9 grid gap-6">
          {ce.consejos.map((c) => (
            <div class="border-l-2 border-tinta pl-4">
              <dt class="font-semibold">{c.titulo}</dt>
              <dd class="mt-1 text-[.95rem] leading-relaxed text-gris">{c.texto}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="grid content-start gap-4 lg:col-span-7">
        {ce.metodos.map((m, i) => (
          <article class:list={['metodo', i === 0 && 'recomendado']} data-revelar style={`--demora:${i * 90}ms`}>
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-[1.15rem] font-semibold">{m.titulo}</h3>
              {i === 0 && <span class="badge-promo">Recomendado</span>}
            </div>
            <ol class="mt-4 grid gap-2.5" role="list">
              {m.pasos.map((p, j) => (
                <li class="flex gap-3 text-[.96rem] leading-relaxed">
                  <span class="paso-num" aria-hidden="true">{j + 1}</span>
                  <span class="min-w-0 break-words">{p}</span>
                </li>
              ))}
            </ol>
            {i === 0 && (
              <a href={negocio.whatsappGeneral} target="_blank" rel="noopener" class="boton boton-principal mt-6 w-full sm:w-auto">
                <Icono nombre="whatsapp" tamano={20} />
                Abrir WhatsApp
              </a>
            )}
          </article>
        ))}
      </div>
    </div>

    {ce.carpetas.length > 0 && (
      <div class="carpetas mt-14 lg:mt-20" data-revelar>
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-2">
          <h3 class="font-display text-[clamp(1.8rem,3.6vw,2.5rem)] leading-none">{ce.carpetas_titulo}</h3>
          {ce.carpetas_bajada && <p class="text-gris">{ce.carpetas_bajada}</p>}
        </div>
        <div class="arboles mt-8">
          {ce.carpetas.map((c, i) => (
            <div class:list={['arbol', i % 2 ? 'con-borde' : 'sin-borde']}>
              <p class="raiz"><Icono nombre="carpeta" tamano={30} /> <span>{c.medida}</span></p>
              <ul class="ramas" role="list">
                {c.subcarpetas.map((s, j) => (
                  <li>
                    <Icono nombre="carpeta" tamano={24} />
                    <span class="font-semibold">{s}</span>
                    <span class="font-mono text-[.66rem] text-gris">IMG_{String(2478 + i * 4 + j)}.JPG</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {ce.carpetas_importante.length > 0 && (
          <div class="importante">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[#0E7A3E] text-papel"><Icono nombre="check" tamano={20} /></span>
            <div>
              <p class="font-semibold">Importante</p>
              <ul class="mt-2 grid gap-1.5 text-[.95rem] text-grafito sm:grid-cols-2" role="list">
                {ce.carpetas_importante.map((x) => <li>{x}</li>)}
              </ul>
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .destacable :global(em) { font-style: italic; color: var(--color-magenta); }
  .metodo { background: var(--color-papel); padding: 1.5rem; border-radius: 4px; }
  @media (min-width: 640px) { .metodo { padding: 1.75rem 2rem; } }
  .recomendado { box-shadow: inset 0 3px 0 var(--color-magenta); }
  .paso-num {
    flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; margin-top: .05rem;
    border-radius: 999px; background: var(--color-mesa); font-family: var(--font-mono); font-size: .75rem;
  }

  /* Ejemplo de carpetas: una por medida, adentro una por cantidad de copias */
  .arboles { display: grid; gap: 1rem; }
  @media (min-width: 768px) { .arboles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .arbol { background: var(--color-papel); border-radius: 4px; padding: 1.5rem; border-top: 4px solid var(--color-cian); }
  .arbol.con-borde { border-top-color: var(--color-magenta); }
  .raiz { display: flex; align-items: center; gap: .6rem; font-size: 1.2rem; font-weight: 600; color: #C98A00; }
  .raiz span { color: var(--color-tinta); }
  .ramas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: 1.1rem; padding-left: 1rem; border-left: 1.5px dashed #C9C9D0; }
  @media (min-width: 1024px) { .ramas { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ramas li { display: grid; justify-items: start; gap: .2rem; font-size: .9rem; color: #C98A00; }
  .ramas li span:first-of-type { color: var(--color-tinta); }
  .importante { display: flex; gap: 1rem; align-items: flex-start; margin-top: 1rem; background: #E3F4EA; border-radius: 4px; padding: 1.25rem 1.5rem; }
</style>
