---
import { preguntas } from '../lib/contenido';
---
<section id="preguntas" class="bg-papel" aria-labelledby="titulo-preguntas">
  <div class="contenedor grid gap-10 py-16 lg:grid-cols-12 lg:gap-14 lg:py-28">
    <div class="lg:col-span-4" data-revelar>
      <p class="etiqueta">Preguntas</p>
      <h2 id="titulo-preguntas" class="titulo-seccion mt-3">{preguntas.titulo}</h2>
    </div>
    <div class="lg:col-span-8" data-revelar style="--demora:80ms">
      {preguntas.lista.map((p) => (
        <details class="pregunta">
          <summary>
            <span>{p.pregunta}</span>
            <span class="signo" aria-hidden="true"></span>
          </summary>
          <p class="pb-6 pr-10 text-[1rem] leading-relaxed text-gris">{p.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .pregunta { border-bottom: 1px solid var(--color-linea); }
  .pregunta:first-child { border-top: 2px solid var(--color-tinta); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.35rem 0; cursor: pointer; list-style: none;
    font-size: 1.08rem; font-weight: 600; line-height: 1.35;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--color-magenta); }
  .signo { position: relative; flex: none; width: 1.1rem; height: 1.1rem; }
  .signo::before, .signo::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform .3s var(--ease-revelado); }
  .signo::after { transform: rotate(90deg); }
  .pregunta[open] .signo::after { transform: rotate(0deg); }
</style>
