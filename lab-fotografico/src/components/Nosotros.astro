---
import { Image, getImage } from 'astro:assets';
import { nosotros, negocio } from '../lib/contenido';
import { destacar } from '../lib/formato';

// Imagen de portada de los videos (se ve antes de que arranque)
const portadas = await Promise.all(
  nosotros.equipos.map((e) => (e.video && e.imagen ? getImage({ src: e.imagen, width: 800, format: 'webp', quality: 80 }) : null)),
);
---
<section id="nosotros" class="bg-papel" aria-labelledby="titulo-nosotros">
  <div class="contenedor py-16 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7" data-revelar>
        <p class="etiqueta">{nosotros.etiqueta}</p>
        <h2 id="titulo-nosotros" class="encabezado mt-4">
          {negocio.anios && <span class="anios">+{negocio.anios}</span>}
          <span class="titulo-seccion destacable block pb-2" set:html={destacar(nosotros.titulo)} />
        </h2>
        <div class="mt-7 grid max-w-2xl gap-4 text-[1.06rem] leading-relaxed text-grafito">
          {nosotros.texto.map((t) => <p>{t}</p>)}
        </div>
      </div>

      <div class="lg:col-span-5" data-revelar style="--demora:120ms">
        <div class="mision">
          <p class="etiqueta !text-gris-claro">{nosotros.mision_titulo}</p>
          <p class="mt-4 text-[1.04rem] leading-relaxed text-[#E4E4E8]">{nosotros.mision}</p>
          {nosotros.frase && (
            <blockquote class="mt-7 border-t border-grafito pt-6">
              <p class="font-display text-[1.75rem] italic leading-[1.12] text-papel">“{nosotros.frase}”</p>
            </blockquote>
          )}
        </div>
      </div>
    </div>

    {nosotros.equipos.length > 0 && (
      <div class="mt-16 lg:mt-24">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3" data-revelar>
          <h3 class="font-display text-[clamp(1.9rem,4vw,2.8rem)] leading-none">{nosotros.equipos_titulo}</h3>
          {nosotros.equipos_bajada && <p class="max-w-md text-gris">{nosotros.equipos_bajada}</p>}
        </div>
        <ul class="equipos mt-8" role="list">
          {nosotros.equipos.map((e, i) => (
            <li class="equipo" data-revelar style={`--demora:${i * 80}ms`}>
              {e.video ? (
                <div class="equipo-foto equipo-video">
                  <video
                    muted loop playsinline preload="none"
                    poster={portadas[i]?.src}
                    data-video={e.video}
                    aria-label={`Video del equipo ${e.nombre} imprimiendo`}
                    class="h-full w-full object-cover"
                  ></video>
                  <span class="en-vivo" aria-hidden="true">En el local</span>
                </div>
              ) : e.imagen && (
                <div class="equipo-foto">
                  <Image
                    src={e.imagen}
                    alt={`Equipo ${e.nombre}`}
                    widths={[Math.min(e.imagen.width, 480), e.imagen.width].filter((v, j, a) => a.indexOf(v) === j)}
                    sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw"
                    format="webp"
                    quality={85}
                    class="h-full w-full object-contain"
                  />
                </div>
              )}
              <p class="mt-4 font-mono text-[.7rem] uppercase tracking-[.08em] text-gris">{e.tipo}</p>
              <h4 class="mt-1.5 text-[1.08rem] font-semibold leading-snug">{e.nombre}</h4>
              <p class="mt-1.5 text-[.93rem] leading-relaxed text-gris">{e.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .destacable :global(em) { font-style: italic; color: var(--color-magenta); }
  .anios {
    font-family: var(--font-display); font-size: clamp(5.5rem, 15vw, 10rem); line-height: .8; letter-spacing: -.04em;
    background: linear-gradient(100deg, var(--color-cian), var(--color-magenta) 55%, #F28C28 85%, var(--color-amarillo));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    font-variant-numeric: tabular-nums; flex: none; align-self: flex-start; padding-right: .1em;
  }
  .encabezado { display: flex; flex-direction: column; gap: .75rem; font-weight: 400; }
  @media (min-width: 640px) { .encabezado { flex-direction: row; align-items: flex-end; gap: 1.25rem; } }
  .mision { background: var(--color-tinta); color: var(--color-papel); padding: 2rem 1.75rem; border-radius: 4px; height: 100%; }
  @media (min-width: 640px) { .mision { padding: 2.5rem 2.25rem; } }
  .equipos { display: grid; gap: 2.25rem 1.5rem; }
  @media (min-width: 640px) { .equipos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .equipos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .equipo { min-width: 0; }
  .equipo-foto { aspect-ratio: 4 / 3; background: #fff; border: 1px solid var(--color-linea); border-radius: 4px; padding: 1rem; display: grid; place-items: center; overflow: hidden; }
  .equipo-video { position: relative; padding: 0; background: #000; border-color: #000; }
  .en-vivo { position: absolute; left: .6rem; top: .6rem; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; background: rgb(0 0 0 / .65); color: #fff; padding: .25rem .5rem; border-radius: 2px; }
  .en-vivo::before { content: ""; display: inline-block; width: .45rem; height: .45rem; border-radius: 999px; background: var(--color-magenta); margin-right: .4rem; vertical-align: .05em; }
</style>

<script>
  // El video del plotter se carga y reproduce recién cuando aparece en pantalla
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-video]');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.video || '';
          if (!reducir) v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    }, { threshold: .35 });
    videos.forEach((v) => io.observe(v));
  }
</script>
