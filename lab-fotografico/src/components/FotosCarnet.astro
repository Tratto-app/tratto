---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { carnet, negocio } from '../lib/contenido';
import { destacar } from '../lib/formato';
---
<section id="fotos-carnet" class="carnet" aria-labelledby="titulo-carnet">
  <div class="contenedor grid gap-12 py-16 lg:grid-cols-12 lg:items-center lg:gap-14 lg:py-24">
    <div class="lg:col-span-6" data-revelar>
      <p class="etiqueta">{carnet.etiqueta}</p>
      <h2 id="titulo-carnet" class="titulo-seccion destacable mt-3" set:html={destacar(carnet.titulo)} />
      <p class="mt-5 max-w-xl text-[1.06rem] leading-relaxed text-grafito">{carnet.texto}</p>
      {carnet.horario && (
        <p class="mt-4 flex items-center gap-2 text-[.98rem] font-semibold">
          <Icono nombre="reloj" tamano={19} clase="text-magenta" /> {carnet.horario}
        </p>
      )}

      {carnet.precios.length > 0 && (
        <dl class="precios mt-8">
          {carnet.precios.map((p) => (
            <div>
              <dt>{p.nombre}</dt>
              <dd>{p.precio || <span class="text-[.95rem] font-sans text-gris">Consultá</span>}</dd>
            </div>
          ))}
        </dl>
      )}

      {carnet.incluye.length > 0 && (
        <div class="mt-7">
          <p class="etiqueta">Incluye</p>
          <ul class="mt-3 grid gap-2.5 text-[.98rem] sm:grid-cols-2" role="list">
            {carnet.incluye.map((x) => (
              <li class="flex items-start gap-2"><Icono nombre="check" tamano={18} clase="mt-[3px] shrink-0 text-cian-texto" />{x}</li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={negocio.whatsappCarnet} target="_blank" rel="noopener" class="boton boton-principal">
          <Icono nombre="whatsapp" tamano={20} /> Consultar por WhatsApp
        </a>
        <a href={negocio.mapaLink} target="_blank" rel="noopener" class="boton boton-secundario">
          <Icono nombre="pin" tamano={19} /> Cómo llegar
        </a>
      </div>
    </div>

    <div class="lg:col-span-6" data-revelar style="--demora:120ms">
      <figure class="hoja m-0">
        <Image
          src={carnet.imagen}
          alt={carnet.foto_descripcion}
          widths={[carnet.imagen.width]}
          sizes="(min-width: 1024px) 34rem, 92vw"
          format="webp"
          quality={86}
          class="block h-auto w-full"
        />
      </figure>
      <div class="direccion">
        <Icono nombre="pin" tamano={22} clase="shrink-0 text-magenta" />
        <div>
          <p class="font-semibold">{negocio.direccion}, {negocio.ciudad}</p>
          {negocio.horarios && <p class="mt-1 whitespace-pre-line text-[.92rem] text-gris">{negocio.horarios}</p>}
        </div>
      </div>
      {carnet.garantia && (
        <p class="garantia">
          <span class="sello-ok" aria-hidden="true"><Icono nombre="check" tamano={18} /></span>
          <span>{carnet.garantia}</span>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .carnet { background: #E9F6FC; }
  .destacable :global(em) { font-style: italic; color: var(--color-magenta); }
  .precios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid var(--color-tinta); max-width: 30rem; }
  .precios > div { padding: .9rem 0; border-bottom: 1px solid #C9DCE6; }
  .precios > div + div { padding-left: 1.25rem; border-left: 1px solid #C9DCE6; }
  .precios dt { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-gris); }
  .precios dd { margin: .35rem 0 0; font-family: var(--font-display); font-size: 1.9rem; line-height: 1; }
  .hoja { background: #fff; padding: clamp(.6rem, 1.6vw, 1rem); box-shadow: 0 1px 2px rgb(0 0 0 / .06), 0 28px 50px -24px rgb(0 0 0 / .35); rotate: -1.5deg; max-width: 34rem; }
  .direccion { display: flex; gap: .75rem; align-items: flex-start; margin-top: 2rem; background: #fff; padding: 1.1rem 1.25rem; border-radius: 4px; max-width: 34rem; }
  .garantia { display: flex; gap: .75rem; align-items: flex-start; margin-top: 1rem; max-width: 34rem; font-size: .95rem; line-height: 1.55; color: var(--color-grafito); }
  .sello-ok { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; flex: none; border-radius: 999px; background: #0E7A3E; color: #fff; }
</style>
