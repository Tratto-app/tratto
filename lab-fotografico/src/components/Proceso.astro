---
import { proceso } from '../lib/contenido';
import { destacar } from '../lib/formato';
---
<section id="como-trabajamos" class="bg-papel" aria-labelledby="titulo-proceso">
  <div class="contenedor py-16 lg:py-28">
    <div data-revelar>
      <p class="etiqueta">{proceso.etiqueta}</p>
      <h2 id="titulo-proceso" class="titulo-seccion destacable mt-3" set:html={destacar(proceso.titulo)} />
    </div>
    <ol class="pasos mt-12 lg:mt-16" role="list">
      {proceso.pasos.map((p, i) => (
        <li class="paso" data-revelar style={`--demora:${i * 90}ms`}>
          <span class="numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-5 text-[1.15rem] font-semibold leading-snug"><span class="sr-only">Paso {i + 1}: </span>{p.titulo}</h3>
          <p class="mt-2 text-[.96rem] leading-relaxed text-gris">{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .destacable :global(em) { font-style: italic; color: var(--color-magenta); }
  .pasos { display: grid; gap: 2.5rem; counter-reset: paso; }
  .paso { position: relative; padding-top: 1.5rem; border-top: 1px solid var(--color-linea); min-width: 0; }
  .paso::before { content: ""; position: absolute; top: -1px; left: 0; width: 3rem; height: 3px; }
  .paso:nth-child(4n+1)::before { background: var(--color-cian); }
  .paso:nth-child(4n+2)::before { background: var(--color-magenta); }
  .paso:nth-child(4n+3)::before { background: var(--color-amarillo); }
  .paso:nth-child(4n+4)::before { background: var(--color-tinta); }
  .numero { display: block; font-family: var(--font-display); font-size: 3.4rem; line-height: .9; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  @media (min-width: 640px) { .pasos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 2rem; } }
  @media (min-width: 1024px) { .pasos { grid-template-columns: repeat(4, minmax(0, 1fr)); } .numero { font-size: 4.2rem; } }
</style>
