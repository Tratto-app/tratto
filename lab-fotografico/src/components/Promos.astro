---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { promos } from '../lib/contenido';
---
{promos.lista.length > 0 && (
  <section id="promos" class="bg-tinta text-papel" aria-labelledby="titulo-promos">
    <div class="contenedor py-16 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4" data-revelar>
        <div>
          <p class="etiqueta !text-gris-claro">Precios especiales</p>
          <h2 id="titulo-promos" class="titulo-seccion mt-3">{promos.titulo}</h2>
        </div>
        {promos.bajada && <p class="max-w-md text-gris-claro">{promos.bajada}</p>}
      </div>

      <ul class="carril mt-10 lg:mt-14" role="list">
        {promos.lista.map((p, i) => (
          <li class="tarjeta-promo group" data-revelar style={`--demora:${i * 70}ms`}>
            <div class="relative aspect-[4/5] overflow-hidden bg-grafito">
              <Image
                src={p.imagen}
                alt={p.foto_descripcion}
                widths={[320, 480, 640, 800]}
                sizes="(min-width: 1280px) 290px, (min-width: 1024px) 22vw, (min-width: 640px) 45vw, 78vw"
                format="webp"
                quality={76}
                class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-revelado)] group-hover:scale-[1.04]"
              />
              <span class="badge-promo absolute left-3 top-3">Promo</span>
            </div>
            <div class="flex flex-1 flex-col pt-5">
              {p.detalle && <p class="font-mono text-[.72rem] uppercase tracking-[.08em] text-gris-claro">{p.detalle}</p>}
              <h3 class="mt-2 text-[1.2rem] font-semibold leading-snug">{p.nombre}</h3>
              <p class="mt-2 text-[.95rem] text-gris-claro">{p.descripcion}</p>
              <div class="mt-auto flex items-center justify-between gap-4 pt-5">
                <p class="font-display text-[1.6rem] leading-none tabular-nums">
                  {p.precio ? p.precio : <span class="whitespace-nowrap font-sans text-[.86rem] text-gris-claro">Consultá el precio</span>}
                </p>
                <a href={p.whatsapp} target="_blank" rel="noopener" class="boton boton-claro min-h-0 px-4 py-2.5 text-[.9rem]" aria-label={`Consultar por ${p.nombre} por WhatsApp`}>
                  <Icono nombre="whatsapp" tamano={16} />
                  Consultar
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-6 flex items-center gap-2 font-mono text-[.72rem] uppercase tracking-[.1em] text-gris-claro sm:hidden" aria-hidden="true">
        <Icono nombre="deslizar" tamano={16} /> Deslizá para ver más
      </p>
    </div>
  </section>
)}

<style>
  /* En el celular las promos se deslizan de costado; en pantallas grandes van en grilla */
  .carril {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.25rem;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    padding-bottom: .25rem;
    scrollbar-width: none;
  }
  .carril::-webkit-scrollbar { display: none; }
  .carril > li { scroll-snap-align: start; }
  @media (min-width: 640px) {
    .carril { grid-auto-flow: row; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-columns: auto; overflow: visible; margin-inline: 0; padding-inline: 0; gap: 2.5rem 1.5rem; }
  }
  @media (min-width: 1024px) {
    .carril { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .tarjeta-promo { display: flex; flex-direction: column; min-width: 0; }
</style>
