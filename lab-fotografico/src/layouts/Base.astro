---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Icono from '../components/Icono.astro';
import { negocio, inicio, servicios, masPedido, preguntas } from '../lib/contenido';

interface Props {
  titulo: string;
  descripcion: string;
  menu: { texto: string; ancla: string; soloCelular?: boolean }[];
}
const { titulo, descripcion, menu } = Astro.props;

const sitio = Astro.site ?? new URL(Astro.url.origin);
const canonica = new URL(Astro.url.pathname, sitio).href;

// Imagen para cuando se comparte el link (WhatsApp, Instagram, Facebook): 1200 × 630
const ogUrl = new URL('/og-fotografia-digital-lp.jpg', sitio).href;

// Datos para Google (schema.org): negocio local, servicios y preguntas frecuentes
const negocioLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${sitio.href}#negocio`,
  name: negocio.nombre,
  description: negocio.descripcion,
  url: sitio.href,
  image: ogUrl,
  telephone: `+${negocio.whatsapp}`,
  ...(negocio.email ? { email: negocio.email } : {}),
  logo: new URL('/icono-512.png', sitio).href,
  address: {
    '@type': 'PostalAddress',
    ...(negocio.direccion ? { streetAddress: negocio.direccion } : {}),
    addressLocality: negocio.ciudad,
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
  areaServed: negocio.ciudad,
  ...(negocio.horarios_google.length ? { openingHours: negocio.horarios_google } : {}),
  hasMap: negocio.mapaLink,
  knowsAbout: ['fotos carnet', 'fotos biométricas', 'copias fotográficas', 'impresiones', 'fotolibros', 'revelado de rollos', 'restauración fotográfica', 'impresión en gran formato'],
  sameAs: [negocio.instagram, negocio.facebook].filter(Boolean),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de impresión fotográfica',
    itemListElement: [...masPedido.lista, ...servicios.lista].map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.nombre, description: s.descripcion },
    })),
  },
};
const preguntasLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.lista.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#000000" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${negocio.nombre}, ${negocio.rubro.toLowerCase()} en ${negocio.ciudad}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fuentes/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fuentes/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={ld(negocioLd)} />
    <script type="application/ld+json" set:html={ld(preguntasLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-papel focus:px-4 focus:py-3">Saltar al contenido</a>
    <Header menu={menu} />
    <main id="contenido">
      <slot />
    </main>

    <a
      href={negocio.whatsappGeneral}
      target="_blank"
      rel="noopener"
      class="whatsapp-flotante"
      aria-label="Escribir por WhatsApp"
    >
      <Icono nombre="whatsapp" tamano={28} />
    </a>

    <style>
      .whatsapp-flotante {
        position: fixed; z-index: 30;
        right: calc(1rem + env(safe-area-inset-right, 0px));
        bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
        display: grid; place-items: center;
        width: 3.6rem; height: 3.6rem; border-radius: 999px;
        background: var(--color-whatsapp); color: #fff;
        box-shadow: 0 10px 24px -6px rgb(0 0 0 / .4);
        transition: transform .25s var(--ease-revelado), background-color .2s;
      }
      .whatsapp-flotante:hover { transform: scale(1.06); background: #14833D; }
      @media (min-width: 1024px) {
        .whatsapp-flotante { right: calc(1.75rem + env(safe-area-inset-right, 0px)); bottom: calc(1.75rem + env(safe-area-inset-bottom, 0px)); }
      }
    </style>

    <script>
      // Aparición suave de las secciones al hacer scroll
      const elementos = document.querySelectorAll('[data-revelar]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: .08 });
        elementos.forEach((el) => io.observe(el));
      } else {
        elementos.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
