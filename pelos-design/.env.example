# =============================================================================
# Pelo's Design — variables de entorno
# Copiá este archivo a .env.local y completá lo que tengas.
# El sitio funciona sin ninguna de estas: cada una activa una función extra.
# =============================================================================

# URL pública final del sitio. Se usa en el canonical, el sitemap, el OG y el
# JSON-LD, así que tiene que ser la definitiva antes de publicar.
NEXT_PUBLIC_SITE_URL=https://pelosdesign.com.ar

# -----------------------------------------------------------------------------
# CONTACTO
# -----------------------------------------------------------------------------
# Número de WhatsApp en formato internacional, sólo dígitos (sin +, espacios ni
# guiones). Ejemplo para un celular de CABA: 5491122334455
# Si queda vacío, todos los CTA de WhatsApp caen automáticamente en Instagram.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Teléfono tal como querés que se muestre y se marque desde el celular.
# Ejemplo: +54 11 4431-3839
# Si queda vacío, no se muestra teléfono en ningún lado ni se emite en el schema.
NEXT_PUBLIC_PHONE=

# -----------------------------------------------------------------------------
# GOOGLE REVIEWS (opcional)
# -----------------------------------------------------------------------------
# Sin API key, la sección de opiniones muestra el CTA hacia la ficha de Google.
# Con key, trae promedio, cantidad y reseñas reales.
#
# La key es SÓLO de servidor: no lleva prefijo NEXT_PUBLIC_ y nunca llega al
# navegador. Restringila a la Places API en la consola de Google Cloud.
GOOGLE_MAPS_API_KEY=

# Place ID de la ficha del salón. Se obtiene en:
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Candidato detectado en directorios públicos (verificar antes de usar):
# ChIJa73tKT_KvJURGft2CzCRPP4
GOOGLE_PLACE_ID=

# -----------------------------------------------------------------------------
# MEDICIÓN (opcional)
# -----------------------------------------------------------------------------
# Código de verificación de Google Search Console (sólo el valor del meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ID de Google Analytics 4. Vacío = no se carga ningún script de analítica.
NEXT_PUBLIC_GA_ID=

# ID del píxel de Meta. Vacío = no se carga.
NEXT_PUBLIC_META_PIXEL_ID=
