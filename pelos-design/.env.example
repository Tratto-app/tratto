# =============================================================================
# Pelo's Design — variables de entorno
# Copiá este archivo a .env.local y completá lo que tengas.
# El sitio funciona sin ninguna de estas: cada una activa una función extra.
# =============================================================================

# URL pública final del sitio. Se usa en el canonical, el sitemap, el OG y el
# JSON-LD, así que tiene que ser la definitiva antes de publicar.
NEXT_PUBLIC_SITE_URL=https://pelosdesign.com.ar

# -----------------------------------------------------------------------------
# CONTACTO
# -----------------------------------------------------------------------------
# El número del salón ya está en src/data/business.ts, así que estas dos
# variables sólo hacen falta para sobrescribirlo (por ejemplo, en un entorno de
# staging que no deba usar el número real).
#
# Formato internacional, sólo dígitos (sin +, espacios ni guiones).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Teléfono tal como se muestra y se marca desde el celular. Ej: +54 9 11 6792-1212
NEXT_PUBLIC_PHONE=

# -----------------------------------------------------------------------------
# LISTA DE PRECIOS (opcional pero recomendado)
# -----------------------------------------------------------------------------
# Link de la planilla de Google que edita el salón. Sirve tanto el link normal
# de la planilla como el de "Publicar en la web" en formato CSV.
#
# La planilla tiene UNA FILA POR SERVICIO y UNA COLUMNA POR LARGO de cabello,
# igual que la lista impresa. Encabezado en la fila 1:
#   Categoria | Servicio | Corto | Mediano | Largo | Extra largo | Nota (opcional)
#
# Si queda vacío, el sitio usa la copia local de src/data/prices.ts.
# Ver el README para el paso a paso completo.
PRICES_SHEET_URL=

# Texto de vigencia que se muestra al pie de la lista. Ej: agosto
# Vacío = no se afirma ninguna fecha.
PRICES_VALID_FROM=

# -----------------------------------------------------------------------------
# GOOGLE REVIEWS (opcional)
# -----------------------------------------------------------------------------
# Sin API key, la sección de opiniones muestra el CTA hacia la ficha de Google.
# Con key, trae promedio, cantidad y reseñas reales.
#
# La key es SÓLO de servidor: no lleva prefijo NEXT_PUBLIC_ y nunca llega al
# navegador. Restringila a la Places API en la consola de Google Cloud.
GOOGLE_MAPS_API_KEY=

# Place ID de la ficha del salón. Se obtiene en:
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Candidato detectado en directorios públicos (verificar antes de usar):
# ChIJa73tKT_KvJURGft2CzCRPP4
GOOGLE_PLACE_ID=

# -----------------------------------------------------------------------------
# MEDICIÓN (opcional)
# -----------------------------------------------------------------------------
# Código de verificación de Google Search Console (sólo el valor del meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ID de Google Analytics 4. Vacío = no se carga ningún script de analítica.
NEXT_PUBLIC_GA_ID=

# ID del píxel de Meta. Vacío = no se carga.
NEXT_PUBLIC_META_PIXEL_ID=
