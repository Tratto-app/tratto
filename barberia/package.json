{
  "name": "barberia-turnos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de atencion automatica por WhatsApp para barberias: agente IA + motor de turnos + sincronizacion con Google Sheets + panel web",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test node --import tsx --test tests/**/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "sheets:setup": "tsx src/google/setup-cli.ts",
    "sheets:sync": "tsx src/google/sync-cli.ts",
    "test:watch": "NODE_ENV=test node --import tsx --test --watch tests/**/*.test.ts",
    "test:postgres": "NODE_ENV=test node --import tsx --test tests/postgres.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
