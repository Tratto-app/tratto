# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a .env y completá los valores.
# NUNCA subas el .env al repositorio: ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# URL pública del servicio (la que ve Meta). Ej: https://turnos.mibarberia.com
APP_BASE_URL=http://localhost:3000

# --- Base de datos -----------------------------------------------------------
# Dejalo vacío para usar SQLite (desarrollo / un solo local).
# En producción se recomienda PostgreSQL: postgresql://usuario:clave@host:5432/base
DATABASE_URL=
SQLITE_PATH=./data/barberia.sqlite

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Se obtienen en developers.facebook.com → tu app → WhatsApp → Configuración de la API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventalo vos: es la palabra secreta que Meta te va a devolver al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta. Sin esto NO se puede validar la firma de los webhooks.
WHATSAPP_APP_SECRET=
# Versión de la Graph API. Ver developers.facebook.com/docs/graph-api/changelog
WHATSAPP_GRAPH_VERSION=v26.0
# WhatsApp del barbero, para avisos de derivación (formato 549XXXXXXXXXX).
BARBERO_WHATSAPP=
# Los recordatorios están APAGADOS. Estas dos variables solo hacen falta si
# algún día los prendés (recordatorios.activos en config/negocio.json).
WHATSAPP_PLANTILLA_RECORDATORIO=
WHATSAPP_PLANTILLA_IDIOMA=es_AR

# --- Inteligencia artificial (Claude) ---------------------------------------
# console.anthropic.com → API Keys
AI_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max — para un chat, low alcanza y es mucho más barato.
AI_EFFORT=low
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=25000
AI_MAX_ITERACIONES=6
AI_HABILITADA=true
AI_FALLBACK_REHUSO=true

# --- Google Sheets -----------------------------------------------------------
# El id está en la URL de la planilla: docs.google.com/spreadsheets/d/<ESTO>/edit
GOOGLE_SPREADSHEET_ID=
# Opción A: OAuth (la planilla queda en el Drive del barbero)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opción B: cuenta de servicio (pegá el JSON completo en una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_HABILITADO=true
SHEETS_INTERVALO_MS=5000

# --- Panel del barbero -------------------------------------------------------
# Contraseña de acceso al panel (mínimo 10 caracteres en producción).
DASHBOARD_PASSWORD=
# Clave para firmar la cookie de sesión. Generala con: openssl rand -hex 32
SESSION_SECRET=
SESSION_HORAS=720

# --- Modo prueba y workers ---------------------------------------------------
SIMULADOR_HABILITADO=true
# Recordatorios apagados. El worker de mantenimiento (liberar horarios
# reservados a medias y limpieza semanal) corre igual: eso no es opcional.
RECORDATORIOS_HABILITADOS=false
WORKERS_HABILITADOS=true
