# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a .env y completá los valores.
# NUNCA subas el .env al repositorio: ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# URL pública del servicio (la que ve Meta). Ej: https://turnos.mibarberia.com
APP_BASE_URL=http://localhost:3000

# --- Base de datos -----------------------------------------------------------
# Dejalo vacío para usar SQLite (desarrollo).
# En producción, PostgreSQL: postgresql://usuario:clave@host:5432/base
DATABASE_URL=

# Solo para docker-compose (VPS propio): clave de la base que se crea sola.
POSTGRES_PASSWORD=
PUERTO_PUBLICO=3000
SQLITE_PATH=./data/barberia.sqlite

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# Se obtienen en developers.facebook.com → tu app → WhatsApp → Configuración de la API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Id de la cuenta de WhatsApp Business donde vive el número. Con esto el
# servidor suscribe la cuenta a la app al arrancar (sin eso no llegan mensajes).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Inventalo vos: es la palabra secreta que Meta te va a devolver al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App secret de la app de Meta. Sin esto NO se puede validar la firma de los webhooks.
WHATSAPP_APP_SECRET=
# Versión de la Graph API. Ver developers.facebook.com/docs/graph-api/changelog
WHATSAPP_GRAPH_VERSION=v26.0
# WhatsApp del barbero, para avisos de derivación (formato 549XXXXXXXXXX).
BARBERO_WHATSAPP=
# Plantilla aprobada para el recordatorio de 24 h. Hace falta cuando pasaron
# más de 24 h desde el último mensaje del cliente (que es lo normal).
# Se crea en WhatsApp → Plantillas de mensajes, con estas variables exactas
# (Meta ya no acepta {{1}}, {{2}}..., solo nombres en minúscula):
# {{nombre_cliente}}, {{fecha_turno}}, {{hora_turno}}, {{servicio}}.
WHATSAPP_PLANTILLA_RECORDATORIO=
# Plantilla para el pedido de reseña. Sale 1 h después del corte, cuando la
# ventana de 24 h casi siempre está cerrada, así que esta hace bastante falta.
# Variables con estos nombres exactos (Meta ya no acepta {{1}}, {{2}}...,
# solo nombres en minúscula): {{nombre_cliente}}, {{link_resena}}, {{descuento}}.
WHATSAPP_PLANTILLA_RESENA=
WHATSAPP_PLANTILLA_IDIOMA=es_AR

# --- Inteligencia artificial -------------------------------------------------
# Qué motor usa el bot: 'claude' u 'openai'. Se cambia sin tocar código.
AI_PROVEEDOR=openai

# --- Si usás OpenAI (platform.openai.com → API keys) ---
OPENAI_API_KEY=
# gpt-6-luna es el más barato y alcanza de sobra para turnos.
# gpt-6-sol si querés más soltura conversando. gpt-6-astra es el más caro.
OPENAI_MODEL=gpt-6-luna

# --- Si usás Claude (console.anthropic.com → API Keys) ---
AI_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max — para un chat, low alcanza y es mucho más barato.
AI_EFFORT=low
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=25000
AI_MAX_ITERACIONES=6
AI_HABILITADA=true
AI_FALLBACK_REHUSO=true

# --- Google Sheets -----------------------------------------------------------
# El id está en la URL de la planilla: docs.google.com/spreadsheets/d/<ESTO>/edit
GOOGLE_SPREADSHEET_ID=
# Opción A: OAuth (la planilla queda en el Drive del barbero)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opción B: cuenta de servicio (pegá el JSON completo en una sola línea)
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_HABILITADO=true
SHEETS_INTERVALO_MS=5000

# --- Panel del barbero -------------------------------------------------------
# Contraseña de acceso al panel (mínimo 10 caracteres en producción).
DASHBOARD_PASSWORD=
# Clave para firmar la cookie de sesión. Generala con: openssl rand -hex 32
SESSION_SECRET=
SESSION_HORAS=720

# --- Modo prueba y workers ---------------------------------------------------
SIMULADOR_HABILITADO=true
RECORDATORIOS_HABILITADOS=true
WORKERS_HABILITADOS=true
