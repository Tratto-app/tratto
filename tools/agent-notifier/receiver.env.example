# Fill only on the persistent host. This file contains no real credentials.
TRATTO_NOTIFY_ENABLED=false
TRATTO_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
TRATTO_BOARD_ID=REPLACE_WITH_BOARD_UUID
TRATTO_CODEX_THREAD_ID=REPLACE_WITH_DEDICATED_CODEX_UUID
TRATTO_REPO=/srv/tratto
TRATTO_CHAT_TOKEN_FILE=/etc/tratto-codex/webhook.token
TRATTO_NOTIFY_DB=/var/lib/tratto-codex/notifications.sqlite
TRATTO_NOTIFY_PORT=8765
# Optional absolute executable path if codex is not on the service user's PATH.
# TRATTO_CODEX_BIN=/path/to/codex
