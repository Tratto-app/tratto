    {
      "id": "9128651c-223b-4e55-9fd5-5a3bc4c8aa3a",
      "name": "Armar aviso al fundador",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -200
      ],
      "parameters": {
        "jsCode": "// Aviso al fundador: un pedido sin nadie, cuántos mails salen solos y los\n// WhatsApp listos para mandar a mano desde su celular (regla: WhatsApp nunca\n// automático).\nconst r = $json || {};\nif (!r.trabajo_id) return [];\nconst rubro = String(r.rubro || '').toLowerCase();\nconst zona = r.zona || 'su zona';\nconst d = String(r.descripcion || '').replace(/[\\s.,;:]+$/, '');\nconst desc = d ? `: «${d}»` : '';\nconst msj = `Hola, soy Agustín, de Tratto. Un vecino de ${zona} está buscando ${rubro}${desc}. Si lo hacés, anotate gratis en www.trattoapp.com.ar (Ofrezco un servicio) y publicá tu servicio: ahí ves el pedido y le mandás tu presupuesto.`;\nconst wa = (r.whatsapp || []).map((w) => {\n  let t = String(w.tel || '').replace(/\\D/g, '');\n  if (!t.startsWith('54')) t = '549' + t.replace(/^0/, '').replace(/^15/, '');\n  return `- ${w.nombre || 'Sin nombre'}${w.misma_zona ? '' : ' (otra zona)'}: https://wa.me/${t}?text=${encodeURIComponent(msj)}`;\n});\nconst lineas = [\n  `Entró un pedido de ${r.rubro} en ${zona} y no hay nadie de ese rubro anotado ${r.motivo === 'rubro_vacio' ? 'en la app' : 'en esa zona'}.`,\n  r.descripcion ? `Lo que pidió (sin datos de contacto): «${r.descripcion}»` : '',\n  '',\n  r.aprobado ? `Mails \"trabajo listo\": ${r.mails}, salen solos de a uno por minuto (8 a 21 h).`\n             : `Mails \"trabajo listo\": ${r.mails} preparados, frenados hasta que apruebes el texto.`,\n  '',\n  wa.length ? `WhatsApp para mandar desde tu celular (tocá el link y se abre con el mensaje):` : 'No hay WhatsApp de este rubro en el CRM.',\n  ...wa,\n];\nreturn [{ json: { asunto: `Pedido sin nadie: ${r.rubro} en ${zona}`, texto: lineas.filter((x, i) => x !== '' || i > 0).join('\\n') } }];"
      }
    },
