    {
      "id": "5f4be4c5-e214-48f6-a8f7-f491296a74fa",
      "name": "Armar mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        280
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mail \"trabajo listo\" (fundador, 23/10/2026): un pedido real de un vecino,\n// sin datos de contacto del cliente. Texto pasado por el humanizador.\nconst f = { ...$json, descripcion: String($json.descripcion || '').replace(/[\\s.,;:]+$/, '') };\nconst rubro = String(f.rubro || '').toLowerCase();\nconst zona = f.zona || 'tu zona';\nconst LINK = 'https://www.trattoapp.com.ar/';\nconst saludo = f.nombre ? `Hola ${f.nombre}, ¿cómo va? Soy Agustín, de Tratto.` : 'Hola, ¿cómo va? Soy Agustín, de Tratto.';\nconst pedido = f.descripcion\n  ? `Hoy un vecino de ${zona} pidió esto en la app: «${f.descripcion}».`\n  : `Hoy un vecino de ${zona} pidió ${rubro} en la app.`;\nconst cerca = f.misma_zona ? '' : ' Si te queda cerca, te puede servir.';\nconst parrafos = [\n  saludo,\n  pedido,\n  `Todavía no hay nadie de ${rubro} anotado en su zona, por eso te lo paso a vos.${cerca}`,\n];\nconst cierre = `Si lo hacés, anotate gratis en www.trattoapp.com.ar, elegí «Ofrezco un servicio» y publicá tu servicio de ${rubro}. Ahí te aparece el pedido y le mandás tu presupuesto por el chat de la app. Hay lugar para ${f.cupo || 5} presupuestos.`;\nconst texto = parrafos.join('\\n\\n') + '\\n\\n' + cierre +\n  '\\n\\nSaludos,\\nAgustín, de Tratto\\nwww.trattoapp.com.ar\\n\\n--\\nSi no querés recibir más mensajes, respondé \"no\" y no te escribimos más.';\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst p = (t) => `<p style=\"margin:0 0 14px\">${t}</p>`;\nconst html = '<div style=\"font:15px/1.6 Arial,Helvetica,sans-serif;color:#0E1815;max-width:560px\">' +\n  parrafos.map((x) => p(esc(x))).join('') +\n  p(esc(cierre).replace('www.trattoapp.com.ar', `<a href=\"${LINK}\" style=\"color:#1E5D49;font-weight:bold\">www.trattoapp.com.ar</a>`)) +\n  '<p style=\"margin:0 0 14px\">Saludos,<br><b>Agustín</b>, de Tratto</p>' +\n  '<p style=\"margin:22px 0 0;padding-top:12px;border-top:1px solid #E0DCD0;font:12px/1.5 Arial,Helvetica,sans-serif;color:#68766F\">Si no querés recibir más mensajes, respondé \"no\" y no te escribimos más.</p></div>';\nconst asunto = `Hay un pedido de ${rubro} en ${zona}`;\nconst b64 = (s) => Buffer.from(String(s), 'utf8').toString('base64').replace(/.{76}(?=.)/g, '$&\\r\\n');\nconst frontera = 'tratto_' + Math.random().toString(36).slice(2);\nconst mime = [\n  `To: ${f.para}`,\n  `Subject: =?UTF-8?B?${Buffer.from(asunto, 'utf8').toString('base64')}?=`,\n  'List-Unsubscribe: <mailto:trattoapp2@gmail.com?subject=baja>',\n  'MIME-Version: 1.0',\n  `Content-Type: multipart/alternative; boundary=\"${frontera}\"`,\n  '',\n  `--${frontera}`, 'Content-Type: text/plain; charset=\"UTF-8\"', 'Content-Transfer-Encoding: base64', '', b64(texto),\n  `--${frontera}`, 'Content-Type: text/html; charset=\"UTF-8\"', 'Content-Transfer-Encoding: base64', '', b64(html),\n  `--${frontera}--`, '',\n].join('\\r\\n');\nreturn { json: { envio_id: f.envio_id, raw: Buffer.from(mime, 'utf8').toString('base64url') } };"
      }
    },
