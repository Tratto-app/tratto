        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.destinatario, titulo: $json.titulo, cuerpo: $json.cuerpo, url: '/', tipo: 'publicidad', canal: 'push' }) }}",
