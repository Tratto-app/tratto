        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.supabaseUrl }}/functions/v1/quick-service",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tratto-firma",
              "value": "={{ $('Configuracion').first().json.pushSecreto }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.destinatario, titulo: $json.titulo, cuerpo: $json.cuerpo, url: '/', tipo: 'publicidad', canal: 'mail' }) }}",
        "options": {}
      }
    }
