      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.supabaseUrl }}/rest/v1/rpc/novedades_a_mandar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Configuracion').first().json.serviceRole }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuracion').first().json.serviceRole }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_canal: 'mail', p_intervalo_dias: $('Configuracion').first().json.intervaloDias }) }}",
        "options": {}
      }
    },
    {
      "id": "65829c6a-1f3b-408d-8dee-86d79d1758bb",
      "name": "Mandar el mail",
