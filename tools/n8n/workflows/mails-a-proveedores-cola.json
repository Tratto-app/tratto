    {
      "id": "f856c21f-5586-4c82-a10b-537ceade6eae",
      "name": "Armar mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el mail con texto y HTML (lo mismo que mandaba el agente con\n// send_message) y lo codifica para la API de Gmail.\nconst m = $json;\nconst b64 = (s) => Buffer.from(String(s), 'utf8').toString('base64').replace(/.{76}(?=.)/g, '$&\\r\\n');\nconst frontera = 'tratto_' + Math.random().toString(36).slice(2);\nconst mime = [\n  `To: ${m.para}`,\n  `Subject: =?UTF-8?B?${Buffer.from(String(m.asunto), 'utf8').toString('base64')}?=`,\n  'MIME-Version: 1.0',\n  `Content-Type: multipart/alternative; boundary=\"${frontera}\"`,\n  '',\n  `--${frontera}`,\n  'Content-Type: text/plain; charset=\"UTF-8\"',\n  'Content-Transfer-Encoding: base64',\n  '',\n  b64(m.texto),\n  `--${frontera}`,\n  'Content-Type: text/html; charset=\"UTF-8\"',\n  'Content-Transfer-Encoding: base64',\n  '',\n  b64(m.html),\n  `--${frontera}--`,\n  '',\n].join('\\r\\n');\nreturn { json: { id: m.id, para: m.para, raw: Buffer.from(mime, 'utf8').toString('base64url') } };"
      }
    },
