    {
      "id": "870c4974-5c2c-4868-9e9a-e1771e5c7de7",
      "name": "Clasificar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Avisos de mailer-daemon de las últimas 24 horas. Bloqueo de Google (5.7.1,\n// límite de envío): la base pone la pausa de 3 días. Rebote: marca al contacto\n// y cuenta para el freno de 3 por día. Las demoras no cuentan.\nconst avisos = [];\nfor (const it of $input.all()) {\n  const m = it.json || {};\n  if (!m.id) continue;\n  const t = String(m.snippet || '');\n  let tipo = null;\n  if (/retras|demor|delay|todav[ií]a no se/i.test(t)) tipo = null;\n  else if (/5\\.7\\.1|message rejected|se bloque[oó]|l[ií]mite|5\\.4\\.5|rate limit|sending limit/i.test(t)) tipo = 'bloqueo';\n  else if (/no se entreg|no se encontr|no encontramos|no se encuentra|5\\.1\\.1|5\\.5\\.0|no est[aá] configurado|no pudo entregarse|address not found|does not exist/i.test(t)) tipo = 'rebote';\n  if (!tipo) continue;\n  const mails = (t.match(/[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+/g) || []).filter((e) => !/trattoapp|googlemail|google\\.com/i.test(e));\n  avisos.push({ dsn_id: m.id, tipo, para: mails[0] || '', texto: t.slice(0, 500) });\n}\nreturn [{ json: { p_items: avisos } }];"
      }
    },
