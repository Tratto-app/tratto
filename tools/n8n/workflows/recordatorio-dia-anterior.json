        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/threads/{{ $json.gmail_thread_id }}?format=metadata&metadataHeaders=From&metadataHeaders=Message-ID&metadataHeaders=Subject&metadataHeaders=References",
        "authentication": "predefinedCredentialType",
