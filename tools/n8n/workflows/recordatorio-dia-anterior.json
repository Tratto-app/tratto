    {
      "id": "5b67664d-6762-47a2-96c9-da2de3f4d7c9",
      "name": "Armar recontacto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Lee el hilo de la presentación. Si hay cualquier mensaje que no es nuestro\n// (respuesta, respuesta automática o rebote), no se recontacta. Si no, arma la\n// respuesta en el mismo hilo (In-Reply-To y References) con el texto del\n// recontacto (fundador, 22/10/2026), pasado por el humanizador.\nconst fila = $('Siguiente recontacto').item.json;\nconst msgs = $json.messages || [];\nconst h = (m, n) => (((m.payload || {}).headers || []).find((x) => x.name.toLowerCase() === n.toLowerCase()) || {}).value || '';\nif (!msgs.length) return { json: { id: fila.id, saltear: true, motivo: 'No se encontró el hilo en Gmail' } };\nconst ajeno = msgs.find((m) => !/trattoapp2@gmail\\.com/i.test(h(m, 'From')));\nif (ajeno) return { json: { id: fila.id, saltear: true, motivo: ('Hay un mensaje en el hilo de ' + h(ajeno, 'From')).slice(0, 300) } };\nconst ultimo = msgs[msgs.length - 1];\nconst msgId = h(ultimo, 'Message-ID');\nconst refs = [h(ultimo, 'References'), msgId].filter(Boolean).join(' ');\nconst asunto = 'Re: ' + String(h(msgs[0], 'Subject') || fila.asunto).replace(/^re:\\s*/i, '');\nconst LINK = 'https://www.trattoapp.com.ar/';\nconst parrafos = [\n  'Hola, ¿cómo va?',\n  'Te escribí ayer desde Tratto y quería saber si llegaste a verlo, por si se te pasó.',\n  'Registrarte y publicar tu servicio es gratis. Cuando alguien de tu zona pide lo que hacés, te llega el aviso al celular y le mandás tu presupuesto por el chat de la app.',\n];\nconst texto = parrafos.join('\\n\\n') +\n  '\\n\\nTe podés anotar en www.trattoapp.com.ar eligiendo «Ofrezco un servicio» (en iPhone también está en la App Store). Si tenés alguna duda, respondé este mail.' +\n  '\\n\\nSaludos,\\nAgustín, de Tratto\\nwww.trattoapp.com.ar\\n\\n--\\nSi no querés recibir más mensajes, respondé \"no\" y no te escribimos más.';\nconst p = (t) => `<p style=\"margin:0 0 14px\">${t}</p>`;\nconst html = '<div style=\"font:15px/1.6 Arial,Helvetica,sans-serif;color:#0E1815;max-width:560px\">' +\n  parrafos.map(p).join('') +\n  p(`Te podés anotar en <a href=\"${LINK}\" style=\"color:#1E5D49;font-weight:bold\">www.trattoapp.com.ar</a> eligiendo «Ofrezco un servicio» (en iPhone también está en la App Store). Si tenés alguna duda, respondé este mail.`) +\n  '<p style=\"margin:0 0 14px\">Saludos,<br><b>Agustín</b>, de Tratto</p>' +\n  '<p style=\"margin:22px 0 0;padding-top:12px;border-top:1px solid #E0DCD0;font:12px/1.5 Arial,Helvetica,sans-serif;color:#68766F\">Si no querés recibir más mensajes, respondé \"no\" y no te escribimos más.</p></div>';\nconst b64 = (s) => Buffer.from(String(s), 'utf8').toString('base64').replace(/.{76}(?=.)/g, '$&\\r\\n');\nconst frontera = 'tratto_' + Math.random().toString(36).slice(2);\nconst mime = [\n  `To: ${fila.para}`,\n  `Subject: =?UTF-8?B?${Buffer.from(asunto, 'utf8').toString('base64')}?=`,\n  ...(msgId ? [`In-Reply-To: ${msgId}`, `References: ${refs}`] : []),\n  'List-Unsubscribe: <mailto:trattoapp2@gmail.com?subject=baja>',\n  'MIME-Version: 1.0',\n  `Content-Type: multipart/alternative; boundary=\"${frontera}\"`,\n  '',\n  `--${frontera}`, 'Content-Type: text/plain; charset=\"UTF-8\"', 'Content-Transfer-Encoding: base64', '', b64(texto),\n  `--${frontera}`, 'Content-Type: text/html; charset=\"UTF-8\"', 'Content-Transfer-Encoding: base64', '', b64(html),\n  `--${frontera}--`, '',\n].join('\\r\\n');\nreturn { json: { id: fila.id, saltear: false, threadId: fila.gmail_thread_id, raw: Buffer.from(mime, 'utf8').toString('base64url') } };"
      }
    },
