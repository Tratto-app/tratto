    {
      "id": "885911c6-c28f-47cc-80c6-ef401761e2fe",
      "name": "Clasificar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Lo que llegó a appsaldia1 en los últimos 2 días. Bloqueo de Google (5.7.1,\n// límite de envío): la base pone la pausa de 3 días. Rebote: esa dirección no\n// recibe más. Respuesta que pide la baja: tampoco. Las demoras no cuentan.\nconst avisos = [];\nconst deQuien = (m) => {\n  const f = m.From || m.from?.text || m.from?.value?.[0]?.address || (m.payload?.headers || []).find((h) => /^from$/i.test(h.name))?.value || '';\n  return String(f);\n};\nconst mailDe = (t) => ((String(t).match(/[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+/g) || []).filter((e) => !/appsaldia1|googlemail|google\\.com/i.test(e)))[0] || '';\nfor (const it of $input.all()) {\n  const m = it.json || {};\n  if (!m.id) continue;\n  const t = String(m.snippet || '');\n  const de = deQuien(m);\n  let tipo = null;\n  let para = '';\n  if (/mailer-daemon|postmaster/i.test(de)) {\n    if (/retras|demor|delay|todav[ií]a no se/i.test(t)) tipo = null;\n    else if (/5\\.7\\.1|message rejected|se bloque[oó]|l[ií]mite|5\\.4\\.5|rate limit|sending limit/i.test(t)) tipo = 'bloqueo';\n    else if (/no se entreg|no se encontr|no encontramos|no se encuentra|5\\.1\\.1|5\\.5\\.0|no est[aá] configurado|no pudo entregarse|address not found|does not exist/i.test(t)) tipo = 'rebote';\n    para = mailDe(t);\n  } else if (/\\bbaja\\b|no me interes|no quiero recibir|no me escrib|dej(?:a|en) de escrib|unsubscribe/i.test(t + ' ' + (m.Subject || m.subject || ''))) {\n    tipo = 'baja';\n    para = mailDe(de);\n  }\n  if (!tipo) continue;\n  avisos.push({ dsn_id: m.id, tipo, para, texto: t.slice(0, 500) });\n}\nreturn [{ json: { p_items: avisos } }];"
      }
    },
