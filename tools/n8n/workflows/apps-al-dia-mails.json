    {
      "id": "e1ad138a-19a5-4693-a8c4-ad9c6771100d",
      "name": "Armar mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el mail con texto y HTML y lo codifica para la API de Gmail.\nconst m = $json;\nconst b64 = (s) => Buffer.from(String(s), 'utf8').toString('base64').replace(/.{76}(?=.)/g, '$&\\r\\n');\nconst enc = (s) => `=?UTF-8?B?${Buffer.from(String(s), 'utf8').toString('base64')}?=`;\nconst frontera = 'apps_' + Math.random().toString(36).slice(2);\nconst mime = [\n  `From: ${enc('Agustín · Apps al día')} <appsaldia1@gmail.com>`,\n  `To: ${m.para}`,\n  `Subject: ${enc(m.asunto)}`,\n  'List-Unsubscribe: <mailto:appsaldia1@gmail.com?subject=baja>',\n  'MIME-Version: 1.0',\n  `Content-Type: multipart/alternative; boundary=\"${frontera}\"`,\n  '',\n  `--${frontera}`,\n  'Content-Type: text/plain; charset=\"UTF-8\"',\n  'Content-Transfer-Encoding: base64',\n  '',\n  b64(m.texto),\n  `--${frontera}`,\n  'Content-Type: text/html; charset=\"UTF-8\"',\n  'Content-Transfer-Encoding: base64',\n  '',\n  b64(m.html),\n  `--${frontera}--`,\n  '',\n].join('\\r\\n');\nreturn { json: { id: m.id, para: m.para, raw: Buffer.from(mime, 'utf8').toString('base64url') } };"
      }
    },
