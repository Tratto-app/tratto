---
import Icono from './Icono.astro';
import Logo from './Logo.astro';
import { negocio, horarios } from '../lib/contenido';
---
<footer class="bg-cafe text-crema">
  <div class="contenedor grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-12 lg:py-16">
    <div class="flex items-center gap-5 lg:col-span-5">
      <Logo tamano={104} />
      <p class="font-titulo text-[1.35rem] italic leading-snug">{negocio.lema}</p>
    </div>
    <div class="lg:col-span-4">
      <p class="bajada text-salvia-clara">Visitanos</p>
      <p class="mt-3">{negocio.direccion}, {negocio.barrio}</p>
      <ul class="mt-2 space-y-0.5 text-[.92rem] text-crema/80">
        {horarios.lineas.map((l) => <li>{l.dias}: {l.horario}</li>)}
      </ul>
    </div>
    <div class="flex flex-col items-start gap-2.5 lg:col-span-3">
      <p class="bajada text-salvia-clara">Escribinos</p>
      <a class="mt-1 inline-flex items-center gap-2 hover:text-salvia-clara" href={negocio.whatsappLink} target="_blank" rel="noopener">
        <Icono nombre="whatsapp" tamano={18} /> {negocio.whatsapp_visible}
      </a>
      {negocio.instagramLink && (
        <a class="inline-flex items-center gap-2 hover:text-salvia-clara" href={negocio.instagramLink} target="_blank" rel="noopener">
          <Icono nombre="instagram" tamano={18} /> @{negocio.instagram}
        </a>
      )}
      <a class="inline-flex items-center gap-2 hover:text-salvia-clara" href={negocio.comoLlegar} target="_blank" rel="noopener">
        <Icono nombre="pin" tamano={18} /> Cómo llegar
      </a>
    </div>
  </div>
  <div class="border-t border-crema/15">
    <p class="contenedor py-5 text-[.8rem] text-crema/70">{negocio.nombre} · {negocio.bajada} · {negocio.barrio}, {negocio.partido}</p>
  </div>
</footer>
