---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import Doodle from './Doodle.astro';
import { carta, negocio } from '../lib/contenido';
---
<section id="carta" class="relative py-20 lg:py-28" aria-labelledby="titulo-carta">
  <div class="contenedor">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-revelar>
      <div class="lg:col-span-7">
        {carta.frase && <p class="script text-[2.5rem] text-terracota sm:text-[2.9rem]">{carta.frase}</p>}
        <h2 id="titulo-carta" class="titulo-seccion relative mt-1 inline-block">
          {carta.titulo}
          <Doodle tipo="destello" clase="absolute -right-12 -top-1 w-10 text-salvia-profunda" />
        </h2>
        {carta.bajada && <p class="mt-3 text-[1.1rem] text-cafe-suave">{carta.bajada}</p>}
      </div>
      {carta.temperatura && (
        <div class="temperatura lg:col-span-5 lg:justify-self-end">
          <Icono nombre="prensa" tamano={26} clase="flex-none text-salvia-profunda" />
          <p>{carta.temperatura}</p>
        </div>
      )}
    </div>

    <div class="pestanas" data-pestanas hidden>
      <div class="pestanas-fila" role="tablist" aria-label="Categorías de la carta">
        {carta.categorias.map((c, i) => (
          <button
            type="button"
            role="tab"
            id={`pestana-${c.id}`}
            aria-controls={c.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-pestana={c.id}
          >{c.nombre}</button>
        ))}
      </div>
    </div>

    <div class="mt-8" data-paneles>
      {carta.categorias.map((c) => (
        <section id={c.id} class="panel" role="tabpanel" aria-labelledby={`pestana-${c.id}`} data-panel>
          <header class="panel-cab">
            <h3 class="titulo text-[1.9rem] sm:text-[2.2rem]">{c.nombre}</h3>
            {c.bajada && <p class="mt-1 max-w-[40rem] text-cafe-suave">{c.bajada}</p>}
          </header>

          {c.grupos.map((g) => (
            <div class="grupo">
              <div class="grupo-cab">
                <h4>{g.titulo}</h4>
              </div>
              {g.descripcion && <p class="grupo-desc">{g.descripcion}</p>}
              <ul class="productos">
                {g.productos.map((p) => (
                  <li class:list={['producto', { 'con-foto': p.imagen }]}>
                    {p.imagen && (
                      <Image
                        src={p.imagen}
                        alt={p.foto_descripcion || p.nombre}
                        widths={[112, 224]}
                        sizes="112px"
                        format="webp"
                        quality={72}
                        class="producto-foto"
                      />
                    )}
                    <div class="min-w-0">
                      <div class="flex items-start justify-between gap-4">
                        <p class="producto-nombre">
                          {p.nombre}
                          {p.etiquetas.map((e) => (
                            <span class={e.toLowerCase() === 'sin tacc' ? 'cinta' : 'etiqueta'}>{e}</span>
                          ))}
                        </p>
                        {p.precioTexto
                          ? <span class="precio">{p.precioTexto}</span>
                          : <span class="precio precio-falta">a completar</span>}
                      </div>
                      {(p.descripcion || p.medida) && (
                        <p class="producto-desc">
                          {p.descripcion}
                          {p.medida && <span class:list={['medida', { 'con-texto': p.descripcion }]}>{p.medida}</span>}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>

    {negocio.menu_pdf && (
      <div class="cierre-carta" data-revelar>
        <p class="script text-[2rem] text-cafe">¿Preferís el menú de siempre?</p>
        <a class="boton boton-borde" href={negocio.menu_pdf} target="_blank" rel="noopener">
          <Icono nombre="documento" tamano={19} />
          {carta.boton_pdf}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .temperatura {
    display: flex; gap: .85rem; align-items: center;
    max-width: 24rem; padding: 1rem 1.15rem;
    background: var(--color-salvia-clara); border-radius: 1rem;
    font-size: .92rem; font-weight: 500; line-height: 1.45;
  }

  /* Pestañas: quedan pegadas arriba mientras se recorre la carta */
  .pestanas {
    position: sticky; top: calc(4rem + env(safe-area-inset-top, 0px)); z-index: 30;
    margin: 2.5rem -1.25rem 0; padding: .75rem 1.25rem;
    background: rgb(239 230 214 / .95);
    backdrop-filter: blur(8px);
  }
  @media (min-width: 768px) { .pestanas { margin-inline: -2.5rem; padding-inline: 2.5rem; } }
  @media (min-width: 1024px) { .pestanas { top: calc(4.75rem + env(safe-area-inset-top, 0px)); } }
  .pestanas-fila { display: flex; gap: .5rem; overflow-x: auto; scrollbar-width: none; scroll-padding-inline: 1.25rem; }
  .pestanas-fila::-webkit-scrollbar { display: none; }
  .pestanas button {
    flex: none; white-space: nowrap; cursor: pointer;
    font: 600 .88rem/1 var(--font-sans);
    color: var(--color-cafe); background: var(--color-blanco);
    border: 1px solid var(--color-linea); border-radius: 999px;
    padding: .78rem 1.1rem; min-height: 2.75rem;
    transition: background-color .2s, color .2s, border-color .2s;
  }
  .pestanas button:hover { border-color: var(--color-cafe); }
  .pestanas button[aria-selected="true"] { background: var(--color-cafe); color: var(--color-crema); border-color: var(--color-cafe); }

  .panel + .panel { margin-top: 4rem; }
  .con-pestanas .panel + .panel { margin-top: 0; }
  .panel[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .panel.entrando { animation: entrar .45s var(--ease-suave); }
    @keyframes entrar { from { opacity: 0; transform: translateY(.6rem); } }
  }
  .panel-cab { margin-bottom: 1.75rem; }

  /* Grupos con el estilo del menú impreso: mayúsculas y raya verde */
  .grupo + .grupo { margin-top: 2.75rem; }
  .grupo-cab { border-bottom: 4px solid var(--color-salvia); padding-bottom: .5rem; }
  .grupo-cab h4 { font: 700 .95rem/1.3 var(--font-sans); letter-spacing: .1em; text-transform: uppercase; }
  .grupo-desc {
    margin-top: 1rem; padding: .85rem 1rem; border-radius: .9rem;
    background: rgb(201 207 184 / .55); font-size: .9rem; font-style: italic; line-height: 1.5;
  }
  .productos { list-style: none; margin: 0; padding: 0; display: grid; column-gap: 3rem; }
  @media (min-width: 900px) { .productos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .producto {
    display: grid; gap: 1rem; align-items: start;
    padding: 1.05rem 0; border-bottom: 1px solid var(--color-linea);
  }
  .producto.con-foto { grid-template-columns: 4.75rem minmax(0, 1fr); }
  @media (min-width: 640px) { .producto.con-foto { grid-template-columns: 5.5rem minmax(0, 1fr); } }
  .producto :global(.producto-foto) {
    width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: .9rem;
    box-shadow: 0 6px 14px -10px rgb(59 42 34 / .7);
    transition: transform .4s var(--ease-suave);
  }
  @media (hover: hover) { .producto:hover :global(.producto-foto) { transform: scale(1.04) rotate(-1.5deg); } }
  .producto-nombre {
    font-family: var(--font-titulo); font-weight: 600; font-size: 1.14rem; line-height: 1.3;
    display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .6rem;
  }
  .producto-nombre :global(.etiqueta), .producto-nombre :global(.cinta) { font-size: .56rem; }
  .producto-desc { margin-top: .3rem; font-size: .9rem; line-height: 1.5; color: var(--color-cafe-suave); }
  .medida { font-family: var(--font-titulo); font-style: italic; white-space: nowrap; }
  .medida.con-texto { margin-left: .55rem; }
  .precio { flex: none; padding-top: .15rem; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .precio-falta {
    font-style: italic; font-weight: 500; font-size: .86rem; color: var(--color-cafe-suave);
    border-bottom: 1.5px dashed rgb(154 67 48 / .55);
  }

  .cierre-carta {
    margin-top: 3.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .75rem 1.5rem;
    text-align: center;
  }
</style>

<script>
  // Pestañas de la carta. Sin JavaScript se ven todas las categorías una abajo de otra.
  const contenedor = document.querySelector<HTMLElement>('[data-pestanas]');
  const paneles = document.querySelector<HTMLElement>('[data-paneles]');
  const pestanas = [...document.querySelectorAll<HTMLButtonElement>('[data-pestana]')];
  const lista = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  function activar(id: string, { mover = false, foco = false, marcar = true } = {}) {
    const pestana = pestanas.find((p) => p.dataset.pestana === id);
    if (!pestana) return false;
    pestanas.forEach((p) => {
      const activa = p === pestana;
      p.setAttribute('aria-selected', String(activa));
      p.tabIndex = activa ? 0 : -1;
    });
    lista.forEach((panel) => {
      const visible = panel.id === id;
      if (visible && panel.hidden) { panel.classList.remove('entrando'); void panel.offsetWidth; panel.classList.add('entrando'); }
      panel.hidden = !visible;
    });
    // Centra la pestaña en la fila (solo de costado: no mueve la página)
    const fila = pestana.parentElement;
    if (fila) fila.scrollTo({ left: pestana.offsetLeft - (fila.clientWidth - pestana.offsetWidth) / 2, behavior: 'smooth' });
    if (foco) pestana.focus();
    if (mover && contenedor) {
      const arriba = contenedor.getBoundingClientRect().top + window.scrollY - (window.innerWidth >= 1024 ? 76 : 64);
      window.scrollTo({ top: arriba, behavior: 'smooth' });
    }
    if (marcar) history.replaceState(null, '', `#${id}`);
    return true;
  }

  if (contenedor && paneles && pestanas.length) {
    contenedor.hidden = false;
    paneles.classList.add('con-pestanas');
    const inicial = location.hash.slice(1);
    if (lista.some((p) => p.id === inicial)) {
      activar(inicial, { marcar: false });
      setTimeout(() => activar(inicial, { mover: true, marcar: false }), 60);
    } else {
      activar(pestanas[0].dataset.pestana!, { marcar: false });
    }

    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => {
        const fueraDeVista = (contenedor.getBoundingClientRect().top < 0) || (paneles.getBoundingClientRect().top < 0);
        activar(p.dataset.pestana!, { mover: fueraDeVista });
      });
      p.addEventListener('keydown', (e) => {
        const ir = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: pestanas.length - 1 }[e.key];
        if (ir === undefined) return;
        e.preventDefault();
        activar(pestanas[(ir + pestanas.length) % pestanas.length].dataset.pestana!, { foco: true });
      });
    });

    // Links de otras secciones a una categoría (por ejemplo, desde la obsesión del mes)
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#carta-"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (activar(a.getAttribute('href')!.slice(1), { mover: true })) e.preventDefault();
      });
    });
  }
</script>
