---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Pie from '../components/Pie.astro';
import Icono from '../components/Icono.astro';
import { negocio, inicio, horarios, carta } from '../lib/contenido';

interface Props {
  titulo: string;
  descripcion: string;
  menu: { texto: string; ancla: string }[];
}
const { titulo, descripcion, menu } = Astro.props;

const sitio = Astro.site ?? new URL(Astro.url.origin);
const canonica = new URL(Astro.url.pathname, sitio).href;

// Imagen para cuando se comparte el link (WhatsApp, Instagram, Facebook): 1200 × 630 en JPG
const og = await getImage({ src: inicio.imagen, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, sitio).href;

// Datos para Google (schema.org): cafetería con dirección, horarios y carta
const cafeLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  '@id': `${sitio.href}#cafe`,
  name: negocio.nombre,
  alternateName: `${negocio.nombre} · ${negocio.bajada}`,
  description: descripcion,
  slogan: negocio.lema,
  url: sitio.href,
  image: ogUrl,
  telephone: `+${negocio.whatsapp}`,
  servesCuisine: ['Café de especialidad', 'Desayunos', 'Meriendas', 'Brunch', 'Pastelería'],
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.direccion,
    addressLocality: negocio.barrio,
    addressRegion: negocio.provincia,
    addressCountry: 'AR',
  },
  areaServed: [negocio.barrio, negocio.partido].filter(Boolean),
  openingHoursSpecification: horarios.especificacion,
  hasMap: negocio.mapa,
  sameAs: [negocio.instagramLink].filter(Boolean),
  hasMenu: {
    '@type': 'Menu',
    url: `${sitio.href}#carta`,
    hasMenuSection: carta.categorias.map((c) => ({
      '@type': 'MenuSection',
      name: c.nombre,
      hasMenuItem: c.grupos.flatMap((g) => g.productos).map((p) => ({
        '@type': 'MenuItem',
        name: p.nombre,
        ...(p.descripcion ? { description: p.descripcion } : {}),
      })),
    })),
  },
};
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#EFE6D6" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={inicio.foto_descripcion} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fuentes/playfair-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fuentes/montserrat.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fuentes/oooh-baby.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={ld(cafeLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-blanco focus:px-5 focus:py-3 focus:font-semibold">Saltar al contenido</a>
    <Header menu={menu} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />

    <a
      href={negocio.whatsappLink}
      target="_blank"
      rel="noopener"
      class="whatsapp-flotante"
      aria-label="Escribinos por WhatsApp"
    >
      <Icono nombre="whatsapp" tamano={28} />
    </a>

    <style>
      .whatsapp-flotante {
        position: fixed; z-index: 35;
        right: calc(1rem + env(safe-area-inset-right, 0px));
        bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
        display: grid; place-items: center;
        width: 3.6rem; height: 3.6rem; border-radius: 999px;
        background: var(--color-whatsapp); color: #fff;
        box-shadow: 0 10px 24px -8px rgb(31 122 77 / .75);
        transition: transform .25s var(--ease-suave), background-color .2s;
      }
      .whatsapp-flotante:hover { transform: scale(1.06); background: #18663F; }
      @media (min-width: 1024px) {
        .whatsapp-flotante { right: calc(1.75rem + env(safe-area-inset-right, 0px)); bottom: calc(1.75rem + env(safe-area-inset-bottom, 0px)); }
      }
    </style>

    <script>
      // Aparición suave de las secciones y dibujos que se trazan solos al aparecer.
      const movimiento = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revelar = document.querySelectorAll<HTMLElement>('[data-revelar]');
      const dibujos = document.querySelectorAll<SVGElement>('.dibujar');
      const enPantalla = (el: Element) => { const r = el.getBoundingClientRect(); return r.top < innerHeight && r.bottom > 0; };
      const dibujar = (el: Element) => { el.classList.remove('oculto'); el.classList.add('anima'); };

      if ('IntersectionObserver' in window && movimiento) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            if (e.target.classList.contains('dibujar')) dibujar(e.target); else e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: .12 });
        revelar.forEach((el) => io.observe(el));
        dibujos.forEach((el) => { if (enPantalla(el)) dibujar(el); else { el.classList.add('oculto'); io.observe(el); } });
      } else {
        revelar.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
